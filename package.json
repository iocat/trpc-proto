{
  "name": "trpc-proto",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint packages benchmarks",
    "clean": "pnpm -r clean",
    "bench:grpc-web": "pnpm --filter @trpc-proto/runtime build && pnpm --filter @trpc-proto/benchmark-grpc-web bench",
    "bench:grpc-web:envoy": "pnpm --filter @trpc-proto/runtime build && pnpm --filter @trpc-proto/benchmark-grpc-web bench -- --envoy",
    "users:generate": "pnpm --filter @trpc-proto/example-users generate",
    "users:server": "pnpm --filter @trpc-proto/example-users run server",
    "todo:generate": "pnpm --filter @trpc-proto/example-todo generate",
    "todo:server": "pnpm --filter @trpc-proto/example-todo run server",
    "trpc:generate": "pnpm --filter @trpc-proto/example-trpc generate",
    "trpc:server": "pnpm --filter @trpc-proto/example-trpc run server"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
