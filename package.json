{
  "name": "trpc-proto",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "users:generate": "pnpm --filter @trpc-proto/example-users generate",
    "users:server": "pnpm --filter @trpc-proto/example-users run server",
    "todo:generate": "pnpm --filter @trpc-proto/example-todo generate",
    "todo:server": "pnpm --filter @trpc-proto/example-todo run server",
    "trpc:generate": "pnpm --filter @trpc-proto/example-trpc generate",
    "trpc:server": "pnpm --filter @trpc-proto/example-trpc run server"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
