{
  "name": "trpc-proto",
  "private": true,
  "type": "module",
  "description": "Generate Protocol Buffers and gRPC transports from tRPC 11 and Zod 4 routers",
  "keywords": [
    "trpc",
    "protobuf",
    "grpc",
    "grpc-web",
    "typescript",
    "zod",
    "code-generation"
  ],
  "homepage": "https://github.com/iocat/trpc-proto#readme",
  "bugs": {
    "url": "https://github.com/iocat/trpc-proto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iocat/trpc-proto.git"
  },
  "license": "MIT",
  "author": "Thanh Ngo <nokotavi@gmail.com>",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint packages benchmarks",
    "clean": "pnpm -r clean",
    "bench:grpc-web": "pnpm --filter @trpc-proto/runtime build && pnpm --filter @trpc-proto/benchmark-grpc-web bench",
    "bench:grpc-web:envoy": "pnpm --filter @trpc-proto/runtime build && pnpm --filter @trpc-proto/benchmark-grpc-web bench -- --envoy",
    "users:generate": "pnpm --filter @trpc-proto/example-users generate",
    "users:server": "pnpm --filter @trpc-proto/example-users run server",
    "todo:generate": "pnpm --filter @trpc-proto/example-todo generate",
    "todo:server": "pnpm --filter @trpc-proto/example-todo run server",
    "trpc:generate": "pnpm --filter @trpc-proto/example-trpc generate",
    "streaming:generate": "pnpm --filter @trpc-proto/example-streaming generate",
    "streaming:server": "pnpm --filter @trpc-proto/example-streaming run server"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
