{
  "name": "@trpc-proto/example-streaming",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "trpc-proto generate --router src/router.ts --export appRouter --out generated",
    "server": "cargo run --manifest-path backend/Cargo.toml",
    "build:rust": "cargo build --manifest-path backend/Cargo.toml",
    "web": "tsx src/web.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc-proto/plugin": "workspace:*",
    "@trpc-proto/runtime": "workspace:*",
    "esbuild": "^0.25.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
