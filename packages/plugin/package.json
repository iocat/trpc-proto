{
  "name": "@trpc-proto/plugin",
  "version": "0.2.2",
  "type": "module",
  "description": "Build-time TypeScript plugin: extract tRPC routers and emit protobuf service declarations",
  "keywords": [
    "trpc",
    "protobuf",
    "code-generation",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/iocat/trpc-proto#readme",
  "bugs": {
    "url": "https://github.com/iocat/trpc-proto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iocat/trpc-proto.git",
    "directory": "packages/plugin"
  },
  "license": "MIT",
  "author": "Thanh Ngo <nokotavi@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "trpc-proto": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm clean && pnpm build",
    "test": "tsx --test src/*_test.ts"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@trpc-proto/schema_ir": "workspace:*",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@trpc/server": "^11.18.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  }
}
