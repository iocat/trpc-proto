{
  "name": "@trpc-proto/example_todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "trpc-proto generate --router src/router.ts --export appRouter --out generated",
    "generate:go": "bash backend/generate.sh",
    "server": "bash -c 'cd backend && go run .'",
    "client": "tsx src/client.ts",
    "web": "tsx src/web.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc-proto/plugin": "workspace:*",
    "@trpc-proto/runtime": "workspace:*",
    "protobufjs": "^7.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
