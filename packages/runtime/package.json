{
  "name": "@trpc-proto/runtime",
  "version": "0.0.0",
  "type": "module",
  "description": "tRPC protobuf transformer and gRPC client transport",
  "keywords": [
    "trpc",
    "protobuf",
    "grpc",
    "grpc-web",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/iocat/trpc-proto#readme",
  "bugs": {
    "url": "https://github.com/iocat/trpc-proto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iocat/trpc-proto.git",
    "directory": "packages/runtime"
  },
  "license": "MIT",
  "author": "Thanh Ngo <nokotavi@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "import": "./dist/batch/index.js"
    },
    "./batch.proto": "./src/batch/proto/generated/trpc_batch_v1.proto",
    "./proto_codec": {
      "types": "./dist/proto_codec/index.d.ts",
      "import": "./dist/proto_codec/index.js"
    },
    "./noop": {
      "types": "./dist/noop.d.ts",
      "import": "./dist/noop.js"
    }
  },
  "files": [
    "dist",
    "src/batch/proto/generated/trpc_batch_v1.proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "generate:batch": "trpc-proto generate --router src/batch/proto/batch_router.ts --export batchRouter --out src/batch/proto/generated",
    "test": "tsx --test \"src/**/*_test.ts\""
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@trpc/client": {
      "optional": true
    }
  },
  "dependencies": {
    "@trpc-proto/schema_ir": "workspace:*",
    "@trpc-proto/utility": "workspace:*",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@trpc-proto/plugin": "workspace:*",
    "@grpc/grpc-js": "^1.13.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  }
}
