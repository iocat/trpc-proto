{
  "name": "@trpc-proto/schema_ir",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared protobuf schema IR for @trpc-proto plugin and runtime",
  "keywords": [
    "trpc",
    "protobuf",
    "schema",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/iocat/trpc-proto#readme",
  "bugs": {
    "url": "https://github.com/iocat/trpc-proto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iocat/trpc-proto.git",
    "directory": "packages/schema_ir"
  },
  "license": "MIT",
  "author": "Thanh Ngo <nokotavi@gmail.com>",
  "engines": {
    "node": ">=22"
  },
